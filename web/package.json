{
  "name": "drop7-research-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/stage-repo-content.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "competition": "node --experimental-strip-types scripts/competition.ts",
    "figures:rules": "node --experimental-strip-types scripts/generate-rules-scenarios.ts",
    "figures:concepts": "node --experimental-strip-types scripts/generate-concept-scenarios.ts",
    "figures:sample-game": "node --experimental-strip-types scripts/generate-sample-game.ts",
    "figures:leaf": "node --experimental-strip-types scripts/generate-leaf-scenarios.ts",
    "figures:cohort": "node --experimental-strip-types scripts/extract-d4-cohort.ts",
    "figures:oracle": "node --experimental-strip-types scripts/generate-oracle-scenario.ts",
    "figures:heuristic": "node --experimental-strip-types scripts/generate-heuristic-figures.ts",
    "check:mdx": "node scripts/check-mdx.mjs ../approaches ./content",
    "test": "node --experimental-strip-types --test lib/play/*.test.ts lib/competition/*.test.ts lib/doc-links.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-secrets-manager": "^3.1116.0",
    "@aws-sdk/lib-dynamodb": "^3.1116.0",
    "@xyflow/react": "^12.11.3",
    "gray-matter": "^4.0.3",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
