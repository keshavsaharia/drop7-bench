# Copy this file to .env.local and replace the placeholder values.
# Never commit .env.local or real GitHub credentials.

# GitHub OAuth App credentials.
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET

# Local URLs for Auth.js and competition submission origin checks.
AUTH_URL=http://localhost:7777
DROP7_SITE_URL=http://localhost:7777

# The only GitHub username allowed to open /analytics or run its Athena queries.
ADMIN_GITHUB_USERNAME=REPLACE_WITH_GITHUB_USERNAME

# AWS-backed analytics is disabled locally unless all of these are configured.
# DROP7_ANALYTICS_FIREHOSE_STREAM=drop7-dev-page-views
# DROP7_ANALYTICS_DATABASE=drop7_dev_analytics
# DROP7_ANALYTICS_TABLE=page_views
# DROP7_ANALYTICS_ATHENA_WORKGROUP=drop7-dev-analytics
