# Safe local smoke matrix. Source this file through cluster/run-matrix.sh.
MATRIX_ROOTS=approaches/fair-expectimax/rust-engine/experiments/example-roots.txt
MATRIX_OUTPUT=runs/local-rust-search-matrix/analytics.jsonl
MATRIX_DEPTHS=2,3
MATRIX_STRATA=3,5
MATRIX_LEAVES=fair,example=approaches/fair-expectimax/rust-engine/experiments/example-perturbed.weights
MATRIX_SCHEDULER=frontier
MATRIX_THREADS=4
MATRIX_CACHE_ENTRIES_PER_WORKER=4096
MATRIX_SPLIT_PLIES=auto
MATRIX_ROOT_LIMIT=2
MATRIX_MAX_FRONTIER_TASKS=1000000
MATRIX_MAX_HOST_BYTES=1073741824
