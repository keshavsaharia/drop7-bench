# Copy to a run directory, replace the root/leaf/output paths, then package it
# with the source snapshot. Depth 7 can consume the entire wall budget.
MATRIX_ROOTS=approaches/fair-expectimax/rust-engine/cluster-input/REPLACE_RUN_ID/roots.txt
MATRIX_OUTPUT=runs/REPLACE_RUN_ID/search-matrix/analytics.jsonl
MATRIX_DEPTHS=4,5,6,7
MATRIX_STRATA=5,7
MATRIX_LEAVES=fair
MATRIX_SCHEDULER=frontier
MATRIX_THREADS=192
MATRIX_CACHE_ENTRIES_PER_WORKER=262144
MATRIX_SPLIT_PLIES=auto
MATRIX_ROOT_LIMIT=8
MATRIX_MAX_FRONTIER_TASKS=1000000
MATRIX_MAX_HOST_BYTES=8589934592
