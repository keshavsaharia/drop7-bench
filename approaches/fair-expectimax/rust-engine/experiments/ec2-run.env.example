# The default hpc7a.96xlarge exposes 192 x86 physical cores (no SMT). Verify
# current regional price/capacity and insert the immutable source/result paths.
AWS_REGION=us-east-2
AWS_AVAILABILITY_ZONE=us-east-2a
AWS_INSTANCE_TYPE=hpc7a.96xlarge
AWS_SUBNET_ID=REPLACE_SUBNET_ID
AWS_SECURITY_GROUP_ID=REPLACE_EGRESS_ONLY_SECURITY_GROUP_ID
AWS_IAM_INSTANCE_PROFILE=REPLACE_SSM_AND_S3_INSTANCE_PROFILE
AWS_SOURCE_S3_URI=s3://REPLACE_BUCKET/REPLACE_RUN_ID/source/drop7-source.tar.gz
AWS_SOURCE_SHA256=REPLACE_64_HEX_SHA256
AWS_RESULT_S3_PREFIX=s3://REPLACE_BUCKET/REPLACE_RUN_ID/results
MATRIX_CONFIG_PATH=approaches/fair-expectimax/rust-engine/cluster-input/REPLACE_RUN_ID/matrix.env
RUN_ID=RUN-REPLACE
MAX_WALL_SECONDS=7200
ASSERTED_HOURLY_PRICE_USD=REPLACE_CURRENT_PRICE
MAX_INSTANCE_COST_USD=REPLACE_BUDGET_CAP
MIN_VCPUS=192
MIN_PHYSICAL_CORES=192
# New accounts commonly have a zero-vCPU default for this adjustable quota.
AWS_VCPU_QUOTA_NAME='Running On-Demand HPC instances'
ROOT_VOLUME_GIB=100
USE_CAPACITY_RESERVATION=1
