{
  "name": "drop7-strategy-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproducible research into public-information Drop7 strategy",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test src/core/typescript/*.test.ts src/bench/*.test.ts",
    "benchmark": "node --experimental-strip-types approaches/baselines-diagnostics/heuristic-benchmark/main.ts",
    "parity": "node --experimental-strip-types approaches/baselines-diagnostics/native-parity/main.ts --native build/native-suite --seed-start 762314752 --seed-count 256",
    "bench": "node --experimental-strip-types src/bench/cli.ts",
    "bench:rounds": "node --experimental-strip-types src/bench/generate-rounds.ts",
    "competition": "npm --prefix web run competition --",
    "web": "npm --prefix web run dev",
    "infra:dev": "sst deploy --stage dev",
    "infra:prod": "sst deploy --stage production",
    "infra:diff:dev": "sst diff --stage dev",
    "infra:diff:prod": "sst diff --stage production"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "sst": "^4.17.1"
  }
}
