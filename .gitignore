.DS_Store
# Anchored to the repository root on purpose. `runs/` unanchored also matched
# `research/runs/`, which silently excluded every machine-readable run record
# that result records cite by id — a fresh clone could not resolve its own
# provenance. The bulk gameplay output under /runs/ (tens of GB) stays ignored.
/build/
/runs/
node_modules/
__pycache__/
*.py[cod]
.venv/
research/generated/index.json
web/.next/
web/data/

# Python virtual environments created by tooling (multi-GB; never committed).
# The bare `.venv/` rule above does not match suffixed names.
.venv*/

# Nested package installs and build output under web/ are also covered by
# web/.gitignore; listed here so the rule survives if that file is edited.
web/node_modules/
web/out/
web/*.tsbuildinfo
